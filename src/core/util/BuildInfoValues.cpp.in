// Edit src/core/util/BuildInfoValues.cpp.in, not the copy in the build folder: src/CMakeLists.txt writes it again at every
// configure.

#include "core/util/BuildInfo.h"

namespace doodlebold::build_info {

QString version() {
    return QStringLiteral("@DOODLEBOLD_VERSION@");
}

QString commit() {
    return QStringLiteral("@DOODLEBOLD_COMMIT@");
}

}
