# Install step of a MinGW build (src/CMakeLists.txt): puts beside doodlebold.exe the Qt plugins it loads at run time, a qt.conf that
# finds them there, and every DLL the exe and those plugins import from the MinGW sysroot. What stays unresolved is Windows' own.
# Set by the install(CODE) before it: DOODLEBOLD_EXE, DOODLEBOLD_MINGW_ROOT, DOODLEBOLD_OBJDUMP.
set(bin "${CMAKE_INSTALL_PREFIX}/bin")
set(plugin_root "${DOODLEBOLD_MINGW_ROOT}/lib/qt6/plugins")
# The plugin folders the app loads from; the debugging and headless platforms aren't shipped.
set(plugin_folders platforms styles imageformats iconengines multimedia tls)
set(left_out qminimal.dll qoffscreen.dll qdirect2d.dll)
set(plugins)
foreach(folder IN LISTS plugin_folders)
  file(GLOB dlls "${plugin_root}/${folder}/*.dll")
  foreach(dll IN LISTS dlls)
    get_filename_component(name "${dll}" NAME)
    if(NOT name IN_LIST left_out)
      file(INSTALL "${dll}" DESTINATION "${bin}/${folder}")
      list(APPEND plugins "${bin}/${folder}/${name}")
    endif()
  endforeach()
endforeach()
file(WRITE "${bin}/qt.conf" "[Paths]\nPlugins = .\n")

# Each file's imports, by objdump, followed into the sysroot's DLLs. file(GET_RUNTIME_DEPENDENCIES) can't do it here: on Linux it looks
# the names up in lower case, and Fedora's sysroot keeps Qt6Core.dll and its like in mixed case.
file(GLOB sysroot_dlls "${DOODLEBOLD_MINGW_ROOT}/bin/*.dll")
foreach(dll IN LISTS sysroot_dlls)
  get_filename_component(name "${dll}" NAME)
  string(TOLOWER "${name}" lower)
  set("sysroot_${lower}" "${dll}")
endforeach()
set(queue "${DOODLEBOLD_EXE}" ${plugins})
set(seen)
set(shipped 0)
set(system)
while(queue)
  list(POP_FRONT queue file)
  execute_process(COMMAND "${DOODLEBOLD_OBJDUMP}" -p "${file}" OUTPUT_VARIABLE dump COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCHALL "DLL Name: [^\n]+" imports "${dump}")
  foreach(line IN LISTS imports)
    string(REGEX REPLACE "DLL Name: " "" name "${line}")
    string(STRIP "${name}" name)
    string(TOLOWER "${name}" lower)
    if(lower IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${lower}")
    if(DEFINED "sysroot_${lower}")
      file(INSTALL "${sysroot_${lower}}" DESTINATION "${bin}")
      get_filename_component(shipped_name "${sysroot_${lower}}" NAME)
      list(APPEND queue "${bin}/${shipped_name}")
      math(EXPR shipped "${shipped} + 1")
    else()
      list(APPEND system "${name}")
    endif()
  endforeach()
endwhile()
message(STATUS "MinGW deploy: ${shipped} DLLs from the sysroot; left to Windows: ${system}")
